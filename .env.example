# AnalystOS Environment Configuration Template
# Copy this file to .env and fill in your API key if you wish to enable real cloud LLM integration.
# The application works 100% offline with deterministic analytical agents if no key is provided.

# Optional: Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: OpenAI API Key (Get key from https://platform.openai.com/)
OPENAI_API_KEY=

# Optional: Groq API Key (Get key from https://console.groq.com/)
GROQ_API_KEY=

# Optional: LLM Provider selection ('gemini', 'openai', 'groq', or 'auto')
LLM_PROVIDER=auto
